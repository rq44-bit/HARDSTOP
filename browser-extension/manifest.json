{
  "manifest_version": 3,
  "name": "HardStop Browser Blocker",
  "version": "0.4.0",
  "key": "",
  "description": "Voluntary gambling-site blocking for Chrome, Edge, Brave, and other Chromium browsers.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "assets/hardstop-logo-16.png",
    "32": "assets/hardstop-logo-32.png",
    "48": "assets/hardstop-logo-48.png",
    "128": "assets/hardstop-logo-128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "tabs",
    "webNavigation",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
